# =============================================================================
# Kivens Arts and Crafts — environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in the values you have. Everything
# here is OPTIONAL — the site runs perfectly without any of it, using the
# sample catalogue and logging enquiries to the terminal.
#
#   cp .env.example .env.local
#
# Never commit .env.local. It is already in .gitignore.
# =============================================================================

# --- Supabase (the product catalogue) ----------------------------------------
# From your Supabase project: Settings → API
# Until both of these are set, the site reads content/products.ts instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Resend (sending enquiry emails) -----------------------------------------
# From https://resend.com → API Keys
# Until RESEND_API_KEY is set, enquiries are printed to the terminal instead.
RESEND_API_KEY=
# The address mail is sent FROM. Must be on a domain verified in Resend.
# While testing you can use: onboarding@resend.dev
CONTACT_FROM_EMAIL=
# The address enquiries are delivered TO — i.e. the workshop's inbox.
CONTACT_TO_EMAIL=
